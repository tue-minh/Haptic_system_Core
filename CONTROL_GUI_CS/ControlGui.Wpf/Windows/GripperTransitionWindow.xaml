<Window x:Class="ControlGui.Wpf.Windows.GripperTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gripper Closure Transition Experiment (Exp 2) — Slow Close &amp; SQLite"
        Height="860" Width="1340"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: parameters -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Connections" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="STM32:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,2"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CboMotorPort" Margin="0,2,6,2" FontWeight="Normal"/>
                            <Button Grid.Row="0" Grid.Column="2" x:Name="BtnMotorConnect" Content="Connect" Margin="0,2" Click="OnMotorConnectClick" FontWeight="Normal"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="PaXini L:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,2"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CboLeftPort" Margin="0,2,6,2" FontWeight="Normal"/>
                            <Button Grid.Row="1" Grid.Column="2" x:Name="BtnLeftConnect" Content="Connect" Margin="0,2" Click="OnLeftConnectClick" FontWeight="Normal"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PaXini R:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,2"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CboRightPort" Margin="0,2,6,2" FontWeight="Normal"/>
                            <Button Grid.Row="2" Grid.Column="2" x:Name="BtnRightConnect" Content="Connect" Margin="0,2" Click="OnRightConnectClick" FontWeight="Normal"/>

                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" x:Name="BtnRefreshPorts" Content="↻"
                                    Margin="4,2,0,2" Click="OnRefreshPortsClick" FontWeight="Normal" ToolTip="Refresh COM ports"/>
                        </Grid>

                        <TextBlock x:Name="TxtComStatus" Text="STM32: not connected" FontSize="11"
                                   Foreground="#616161" FontWeight="Normal" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtSensorStatus" Text="PaXini sensors: not connected" FontSize="11"
                                   Foreground="#616161" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Gripper motion (STS3215)" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <!-- Servo ID, Scan & Ping -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Servo ID:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" x:Name="TxtServoId" Text="1" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                     FontWeight="Normal" TextChanged="OnServoIdTextChanged"/>
                            <Button Grid.Column="2" x:Name="BtnScanServo" Content="Scan ID" Margin="0,0,4,0" FontWeight="Normal"
                                    IsEnabled="False" ToolTip="Scan bus for active STS3215 servo IDs (1..16)" Click="OnScanServoClick"/>
                            <Button Grid.Column="3" x:Name="BtnPingServo" Content="Ping" Margin="0,0,4,0" FontWeight="Normal"
                                    IsEnabled="False" ToolTip="Ping the selected servo ID" Click="OnPingServoClick"/>
                            <TextBlock Grid.Column="4" x:Name="TxtServoStatus" Text="Offline" VerticalAlignment="Center"
                                       Foreground="#757575" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Open position:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOpenPos" Text="55" Margin="0,3" FontWeight="Normal"
                                     ToolTip="Servo step for fully open (55..419)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Close position:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtClosePos" Text="420" Margin="0,3" FontWeight="Normal"
                                     ToolTip="Servo step for fully closed (open+1..420)"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Close speed (steps/s):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSpeed" Text="150" Margin="0,3" FontWeight="Normal"
                                     ToolTip="Low velocity. STS3215 range 100..3000 steps/s"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Acceleration:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtAccel" Text="20" Margin="0,3" FontWeight="Normal"
                                     ToolTip="STS3215 acceleration factor 10..200"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Settle open (s):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtSettle" Text="1.5" Margin="0,3" FontWeight="Normal"
                                     ToolTip="Baseline recording once the gripper reaches the open position"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Hold closed (s):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtHold" Text="3" Margin="0,3" FontWeight="Normal"
                                     ToolTip="Keep sampling at the closed position after the servo stops"/>

                            <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkRelease"
                                      Content="Return to open position at the end" IsChecked="True" FontWeight="Normal" Margin="0,6,0,2"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Stepper Motion (Post-Close)" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Motion mode:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <ComboBox Grid.Column="1" x:Name="CboMotionMode" FontWeight="Normal" SelectionChanged="OnMotionModeChanged">
                                <ComboBoxItem Content="None (Close &amp; Hold only)" Tag="none" IsSelected="True"/>
                                <ComboBoxItem Content="Close → Z- → Return Z → Release" Tag="z_minus"/>
                                <ComboBoxItem Content="Close → X+ → Return X → Release" Tag="x_plus"/>
                                <ComboBoxItem Content="Close → Y+ → Return Y → Release" Tag="y_plus"/>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Distance (mm):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMotionDist" Text="10" Margin="0,3,6,3" FontWeight="Normal"
                                     ToolTip="Excursion distance along Z-, X+, or Y+ in mm"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Hold peak (s):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtHoldTarget" Text="1.0" Margin="0,3" FontWeight="Normal"
                                     ToolTip="Dwell time at Z-/X+/Y+ before returning"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="X/Y Vel (mm/s):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtXyVel" Text="5" Margin="0,3,6,3" FontWeight="Normal"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="X/Y Accel:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtXyAccel" Text="50" Margin="0,3" FontWeight="Normal"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Z Vel (mm/s):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtZVel" Text="2" Margin="0,3,6,3" FontWeight="Normal"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Z Accel:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="TxtZAccel" Text="50" Margin="0,3" FontWeight="Normal"/>

                            <Button Grid.Row="3" Grid.Column="0" x:Name="BtnStepEnable" Content="Enable Stepper" Margin="0,4,6,2" FontWeight="Normal"
                                    IsEnabled="False" Click="OnStepEnableClick"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtStepperPos"
                                       Text="Stepper: ---" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                       Foreground="#616161" FontWeight="Normal" Margin="0,4,0,2"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sampling &amp; SQLite Logging" FontWeight="Bold" Margin="0,0,0,8">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sample rate (Hz):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtRateHz" Text="50" Margin="0,3" FontWeight="Normal"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="ADC CS:" VerticalAlignment="Center" FontWeight="Normal" Margin="8,3,0,3"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CboSpiCs" Margin="0,3" FontWeight="Normal">
                            <ComboBoxItem Content="CS1" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="CS2" Tag="1"/>
                            <ComboBoxItem Content="CS3" Tag="2"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ADC Vref (mV):" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtVref" Text="3300" Margin="0,3" FontWeight="Normal"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SQLite DB:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtDbPath" Margin="0,3" FontWeight="Normal"/>
                        <Button Grid.Row="2" Grid.Column="3" Content="..." Width="30" HorizontalAlignment="Left" Margin="6,3,0,3" Click="OnBrowseDb" FontWeight="Normal"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                                   Text="Tables: experiment_meta, samples (all 5 valve ADC channels + both PaXini metrics), transition_summary"
                                   FontSize="11" Foreground="#616161" FontWeight="Normal" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2,0,8">
                    <Button x:Name="BtnStart" Content="Start Experiment" Width="165" Height="34"
                            Background="#1976D2" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" Click="OnStartClick"/>
                    <Button x:Name="BtnStop" Content="Stop" Width="165" Height="34"
                            IsEnabled="False" FontWeight="Bold" Click="OnStopClick"/>
                </StackPanel>

                <GroupBox Header="Run Status" FontWeight="Bold">
                    <StackPanel Margin="6">
                        <ProgressBar x:Name="ProgRun" Height="10" IsIndeterminate="False" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtStatus" Text="Idle — ready" FontFamily="Consolas" FontSize="11"
                                   FontWeight="Normal" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtOnsets" Text="Transitions: ---" FontFamily="Consolas" FontSize="11"
                                   FontWeight="Normal" TextWrapping="Wrap" Foreground="#1565C0" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtDbInfo" Text="" FontSize="10" Foreground="#757575"
                                   FontWeight="Normal" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#E0E0E0"/>

        <!-- Right column: live data + plots -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Live readings" FontWeight="Bold">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Servo pos" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtLivePos" Text="---" FontFamily="Consolas" FontSize="16" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Load %" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtLiveLoad" Text="---" FontFamily="Consolas" FontSize="16" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="L Fmag N" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtLiveLF" Text="---" FontFamily="Consolas" FontSize="16" Foreground="#1976D2" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="L Fz N" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtLiveLFz" Text="---" FontFamily="Consolas" FontSize="16" Foreground="#1976D2" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="R Fmag N" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TxtLiveRF" Text="---" FontFamily="Consolas" FontSize="16" Foreground="#2E7D32" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="5" Text="R Fz N" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" x:Name="TxtLiveRFz" Text="---" FontFamily="Consolas" FontSize="16" Foreground="#2E7D32" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Valve max mV" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" x:Name="TxtLiveValve" Text="---" FontFamily="Consolas" FontSize="16" Foreground="#D32F2F" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="7" Text="Stepper XYZ mm" FontSize="10" Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="7" x:Name="TxtLiveStep" Text="---" FontFamily="Consolas" FontSize="13" Foreground="#424242" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <GroupBox Grid.Row="2" Header="PaXini force history — L Fmag (blue) / R Fmag (green)" FontWeight="Bold">
                <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Margin="4">
                    <Canvas x:Name="CanvasForce" ClipToBounds="True" SizeChanged="OnCanvasSizeChanged"/>
                </Border>
            </GroupBox>

            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <GroupBox Grid.Row="4" Header="Valve ADC history (mV) — CH0..CH4" FontWeight="Bold">
                <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Margin="4">
                    <Canvas x:Name="CanvasValve" ClipToBounds="True" SizeChanged="OnCanvasSizeChanged"/>
                </Border>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
