<Window x:Class="ControlGui.Wpf.Windows.SupRingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:ControlGui.Wpf.Panels"
        Title="SuP / Ring Manual Control &amp; ADC Monitor (CAN 0x300)"
        Height="880" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560" MinWidth="500"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Connection + Interactive 2D SuP Pad + Force/Angle Sliders + ESP32 0x300 Params -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- STM32 Connection -->
                <GroupBox Header="STM32 Link" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COM Port:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CboComPort" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" x:Name="BtnConnect" Content="Connect" Click="OnConnectClick"/>
                            <Button Grid.Column="3" Content="↻" Margin="4,0,0,0" ToolTip="Refresh COM ports" Click="OnRefreshPortsClick"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtComStatus" Text="Disconnected" VerticalAlignment="Center"
                                       Foreground="#757575" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" x:Name="BtnPingEsp32" Content="Ping ESP32 (0x301)" Padding="10,4"
                                    IsEnabled="False" Click="OnPingEsp32Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtPingResult" Text="ESP32 ping: not run" FontSize="11"
                                   Foreground="#757575" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Interactive 2D SuP / Ring Pad -->
                <GroupBox Header="SuP / Ring 2D Force Pad (I01 Paper Convention — Drag to Steer, Right-Click = Zero Shear)" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <Border Background="#FFFFFF" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4">
                            <Canvas x:Name="CanvasSupPad" Height="220" ClipToBounds="True" Cursor="Hand"
                                    SizeChanged="OnPadSizeChanged"
                                    MouseLeftButtonDown="OnPadMouseDown"
                                    MouseMove="OnPadMouseMove"
                                    MouseLeftButtonUp="OnPadMouseUp"
                                    MouseRightButtonDown="OnPadRightDown"/>
                        </Border>

                        <!-- Quick Direction Presets matching I01 Fig. 2(d) -->
                        <WrapPanel Margin="0,8,0,2">
                            <Button Content="Slide Down (-Fx · A)" Padding="8,4" Margin="0,0,4,4" Click="OnPresetDirectionClick" Tag="slide_down"/>
                            <Button Content="Slide Up (+Fx · C)" Padding="8,4" Margin="0,0,4,4" Click="OnPresetDirectionClick" Tag="slide_up"/>
                            <Button Content="Pull (-Fy · D)" Padding="8,4" Margin="0,0,4,4" Click="OnPresetDirectionClick" Tag="pull"/>
                            <Button Content="Push (+Fy · E)" Padding="8,4" Margin="0,0,4,4" Click="OnPresetDirectionClick" Tag="push"/>
                            <Button Content="Squeeze Only (Fz · B)" Padding="8,4" Margin="0,0,4,4" Click="OnPresetDirectionClick" Tag="squeeze"/>
                            <Button Content="Zero Shear" Padding="8,4" Margin="0,0,4,4" Click="OnZeroShearClick"/>
                            <Button Content="VENT ALL (0 N)" Padding="10,4" Margin="0,0,0,4"
                                    Background="#D32F2F" Foreground="White" FontWeight="Bold" Click="OnVentAllClick"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Manual Direction & Magnitude Sliders -->
                <GroupBox Header="Manual 3-DOF Force &amp; Angle (N / deg)" FontWeight="Bold" Margin="0,0,0,8">
                    <Grid Margin="6" TextElement.FontWeight="Normal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fz -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fz — Squeeze (Valve B):" VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="SliderFz" Minimum="0" Maximum="25.5" Value="0" Margin="4,4,8,4" VerticalAlignment="Center" ValueChanged="OnCartesianChanged"/>
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtFz" Text="0.0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontFamily="Consolas" Margin="0,3" TextChanged="OnCartesianTextChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="N" VerticalAlignment="Center" Foreground="#616161" Margin="4,0,0,0"/>

                        <!-- Fx -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fx — Down(-A) / Up(+C):" VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="SliderFx" Minimum="-25.5" Maximum="25.5" Value="0" Margin="4,4,8,4" VerticalAlignment="Center" ValueChanged="OnCartesianChanged"/>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtFx" Text="0.0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontFamily="Consolas" Margin="0,3" TextChanged="OnCartesianTextChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="N" VerticalAlignment="Center" Foreground="#616161" Margin="4,0,0,0"/>

                        <!-- Fy -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fy — Pull(-D) / Push(+E):" VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="SliderFy" Minimum="-25.5" Maximum="25.5" Value="0" Margin="4,4,8,4" VerticalAlignment="Center" ValueChanged="OnCartesianChanged"/>
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtFy" Text="0.0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontFamily="Consolas" Margin="0,3" TextChanged="OnCartesianTextChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="N" VerticalAlignment="Center" Foreground="#616161" Margin="4,0,0,0"/>

                        <!-- Shear |Ft| -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Shear Magnitude |Ft|:" VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="SliderMag" Minimum="0" Maximum="25.5" Value="0" Margin="4,4,8,4" VerticalAlignment="Center" ValueChanged="OnPolarChanged"/>
                        <TextBox Grid.Row="3" Grid.Column="2" x:Name="TxtMag" Text="0.0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontFamily="Consolas" Margin="0,3" TextChanged="OnPolarTextChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="N" VerticalAlignment="Center" Foreground="#616161" Margin="4,0,0,0"/>

                        <!-- Shear Angle -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Shear Angle θ (0°=+Fy E):" VerticalAlignment="Center" Margin="0,4"/>
                        <Slider Grid.Row="4" Grid.Column="1" x:Name="SliderAngle" Minimum="0" Maximum="360" Value="0" Margin="4,4,8,4" VerticalAlignment="Center" ValueChanged="OnPolarChanged"/>
                        <TextBox Grid.Row="4" Grid.Column="2" x:Name="TxtAngle" Text="0.0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontFamily="Consolas" Margin="0,3" TextChanged="OnPolarTextChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="deg" VerticalAlignment="Center" Foreground="#616161" Margin="4,0,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- ESP32 CAN 0x300 Parameters & Chamber Output Feedback -->
                <GroupBox Header="ESP32 CAN 0x300 Parameters &amp; Chamber Feedback" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="ChkStream" Content="Stream CAN 0x300 (uncheck to test 150 ms watchdog)"
                                      IsChecked="True" VerticalAlignment="Center" Checked="OnStreamParamChanged" Unchecked="OnStreamParamChanged"/>
                            <TextBlock Grid.Column="1" Text="TX Hz:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Grid.Column="2" x:Name="TxtTxRateHz" Text="100" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                     FontFamily="Consolas" TextChanged="OnTxRateTextChanged"/>
                        </Grid>

                        <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoFlags" Content="Auto Flags" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                      Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/>
                            <CheckBox x:Name="ChkFlagL" Content="L(0x01)" IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/>
                            <CheckBox x:Name="ChkFlagR" Content="R(0x02)" IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/>
                            <CheckBox x:Name="ChkFlagSlip" Content="Slip(0x04)" IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/>
                            <CheckBox x:Name="ChkFlagTare" Content="Tare(0x08)" IsEnabled="False" Margin="0,0,10,0" VerticalAlignment="Center" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/>
                            <TextBlock Text="Res[5]:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtReserved" Text="0x00" Width="46" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontFamily="Consolas" TextChanged="OnReservedTextChanged"/>
                        </WrapPanel>

                        <StackPanel x:Name="PanelValveFeedback"/>

                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtTxStats" Text="TX: idle (0 frames, 0.0 Hz)" FontFamily="Consolas" FontSize="11" Foreground="#424242"/>
                                <TextBlock x:Name="TxtWireFrame" Text="Wire 0x300: ---" FontFamily="Consolas" FontSize="10" Foreground="#757575" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <panels:HapticMappingPanel x:Name="PanelMapping" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#E0E0E0"/>

        <!-- Right Column: SPI ADC Readout + SQLite Logging + Scrolling Waveform -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <panels:AdcPanel Grid.Row="0" x:Name="PanelAdc"/>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- SQLite Logging -->
            <GroupBox Grid.Row="2" Header="SQLite Experiment Logging" FontWeight="Bold">
                <Grid Margin="6" TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtDbPath" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                    <Button Grid.Row="0" Grid.Column="1" x:Name="BtnBrowseDb" Content="..." Width="30" Margin="0,0,6,0" Click="OnBrowseDbClick"/>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="BtnToggleLog" Content="Start Log" Width="105" Padding="8,4"
                            Background="#1976D2" Foreground="White" FontWeight="Bold" Click="OnToggleLogClick"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="TxtLogStatus"
                               Text="Idle — ready to log (experiment_meta, samples)" FontFamily="Consolas" FontSize="11"
                               Foreground="#616161" Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <GroupBox Grid.Row="4" Header="Live ADC Waveform (mV) — CH0..CH4" FontWeight="Bold">
                <Grid Margin="6" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkPlot0" Content="CH0 (A)" IsChecked="True" Foreground="#D32F2F" FontWeight="SemiBold" Margin="0,0,10,0" Checked="OnPlotFilterChanged" Unchecked="OnPlotFilterChanged"/>
                            <CheckBox x:Name="ChkPlot1" Content="CH1 (B)" IsChecked="True" Foreground="#E65100" FontWeight="SemiBold" Margin="0,0,10,0" Checked="OnPlotFilterChanged" Unchecked="OnPlotFilterChanged"/>
                            <CheckBox x:Name="ChkPlot2" Content="CH2 (C)" IsChecked="True" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,0,10,0" Checked="OnPlotFilterChanged" Unchecked="OnPlotFilterChanged"/>
                            <CheckBox x:Name="ChkPlot3" Content="CH3 (D)" IsChecked="True" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,10,0" Checked="OnPlotFilterChanged" Unchecked="OnPlotFilterChanged"/>
                            <CheckBox x:Name="ChkPlot4" Content="CH4 (E)" IsChecked="True" Foreground="#6A1B9A" FontWeight="SemiBold" Checked="OnPlotFilterChanged" Unchecked="OnPlotFilterChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear Plot" Padding="10,3" Click="OnClearPlotClick"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Canvas x:Name="CanvasAdcPlot" ClipToBounds="True" SizeChanged="OnCanvasSizeChanged"/>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="TxtAdcLatest" Text="Latest mV: ---" FontFamily="Consolas" FontSize="11"
                               Foreground="#424242" Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
