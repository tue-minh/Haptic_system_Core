<Window x:Class="ControlGui.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panels="clr-namespace:ControlGui.Wpf.Panels"
        xmlns:controls="clr-namespace:ControlGui.Wpf.Controls"
        mc:Ignorable="d"
        Title="Unified Motor Control &amp; Dual PaXini Tactile GUI" 
        Height="980" Width="1680"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Top Main Splitter (Left Column Controls vs Right Column Visualizations) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="460"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Controls in ScrollViewer -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <panels:ConnectionPanel x:Name="PanelConnection"/>
                    <panels:StepperPanel x:Name="PanelStepper"/>
                    <panels:GripperPanel x:Name="PanelGripper"/>
                    <panels:HapticPanel x:Name="PanelHaptic"/>
                    <panels:RecordingPanel x:Name="PanelRecording"/>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#E0E0E0"/>

            <!-- Right Column: Visualizations & Monitor -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="250"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="4*" MinHeight="300"/>
                </Grid.RowDefinitions>

                <!-- Top Right: Sensor Monitor Panel -->
                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="#FFFFFF">
                    <panels:SensorMonitorPanel x:Name="PanelSensorMonitor"/>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

                <!-- Bottom Right: Tabbed Surface Views -->
                <GroupBox Grid.Row="2" Header="Tactile surface &amp; haptic output" FontWeight="Bold" Foreground="#212121">
                    <TabControl x:Name="TabsSurface" FontWeight="Normal" Background="#FFFFFF" Margin="2">
                        <TabItem Header="Taxel map (live)">
                            <controls:TaxelMapView x:Name="ViewTaxelMap"/>
                        </TabItem>
                        <TabItem Header="3D cloud">
                            <controls:Tactile3DView x:Name="View3D"/>
                        </TabItem>
                        <TabItem Header="Haptic valves (5)">
                            <controls:ValveMapView x:Name="ViewValves"/>
                        </TabItem>
                    </TabControl>
                </GroupBox>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

        <!-- Bottom: Rolling Event Log -->
        <GroupBox Grid.Row="2" Header="System Log" FontWeight="SemiBold" Foreground="#424242">
            <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" Background="#FFFFFF" BorderThickness="0" TextWrapping="NoWrap"/>
        </GroupBox>
    </Grid>
</Window>
