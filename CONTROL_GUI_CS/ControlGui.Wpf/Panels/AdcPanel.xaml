<UserControl x:Class="ControlGui.Wpf.Panels.AdcPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="450">
    <GroupBox Header="ITV valve ADC  (STM32F103 SPI slave)" Margin="0,0,0,6" FontWeight="Bold" Foreground="#212121">
        <StackPanel Margin="6" TextElement.FontWeight="Normal">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" Foreground="#757575" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Raw" Foreground="#757575" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Millivolts" Foreground="#757575" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Level" Foreground="#757575" FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="CH0 · PA0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRaw0" Grid.Row="1" Grid.Column="1" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMv0" Grid.Row="1" Grid.Column="2" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Bar0" Grid.Row="1" Grid.Column="3" Height="9" Margin="4,2" Minimum="0" Maximum="4095" Value="0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="CH1 · PA1" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRaw1" Grid.Row="2" Grid.Column="1" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMv1" Grid.Row="2" Grid.Column="2" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Bar1" Grid.Row="2" Grid.Column="3" Height="9" Margin="4,2" Minimum="0" Maximum="4095" Value="0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="CH2 · PA2" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRaw2" Grid.Row="3" Grid.Column="1" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMv2" Grid.Row="3" Grid.Column="2" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Bar2" Grid.Row="3" Grid.Column="3" Height="9" Margin="4,2" Minimum="0" Maximum="4095" Value="0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="CH3 · PA3" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRaw3" Grid.Row="4" Grid.Column="1" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMv3" Grid.Row="4" Grid.Column="2" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Bar3" Grid.Row="4" Grid.Column="3" Height="9" Margin="4,2" Minimum="0" Maximum="4095" Value="0"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="CH4 · PA4" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRaw4" Grid.Row="5" Grid.Column="1" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMv4" Grid.Row="5" Grid.Column="2" Text="---" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Bar4" Grid.Row="5" Grid.Column="3" Height="9" Margin="4,2" Minimum="0" Maximum="4095" Value="0"/>
            </Grid>

            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                <TextBlock x:Name="TxtStatus" Text="no data" Foreground="#757575" FontFamily="Consolas" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox x:Name="ChkEnable" Content="Poll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="CS" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="CmbCs" Width="56" Margin="0,0,8,0"/>
                <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="CmbPeriod" Width="72" Margin="0,0,8,0"/>
                <Button x:Name="BtnApply" Content="Apply" Height="24" Margin="0,0,6,0" Click="OnApplyClick"
                        ToolTip="Send CAN 0x502 to change the master polling slot/rate."/>
                <Button x:Name="BtnRead" Content="Read now" Height="24" Click="OnReadClick"/>
            </StackPanel>

            <TextBlock x:Name="TxtFooter" Text="not connected" Foreground="#757575" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </GroupBox>
</UserControl>
