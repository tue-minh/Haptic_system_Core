<UserControl x:Class="ControlGui.Wpf.Panels.GripperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="450">
    <GroupBox Header="Gripper  (STS3215 Servo)" Margin="0,0,0,6" FontWeight="Bold" Foreground="#212121">
        <StackPanel Margin="6" TextElement.FontWeight="Normal">
            <!-- Servo ID & Scan row -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Servo ID:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtServoId" Text="1" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" x:Name="BtnScan" Content="Scan Servo" Margin="0,0,4,0" ToolTip="Scan bus for active STS3215 servo IDs (1..16)" Click="OnScanClick"/>
                <Button Grid.Column="3" x:Name="BtnPing" Content="Ping" Margin="0,0,4,0" ToolTip="Ping current servo ID" Click="OnPingClick"/>
                <TextBlock Grid.Column="4" x:Name="TxtServoStatus" Text="Offline" VerticalAlignment="Center" Foreground="#757575" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Readouts grid -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Position" Foreground="#757575"/>
                <Border Grid.Column="0" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2,4,0">
                    <TextBlock x:Name="TxtReadoutPos" Text="----" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1" Grid.Row="0" Text="Supply" Foreground="#757575"/>
                <Border Grid.Column="1" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2,4,0">
                    <TextBlock x:Name="TxtReadoutVolt" Text="---- V" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="2" Grid.Row="0" Text="Load" Foreground="#757575"/>
                <Border Grid.Column="2" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2,4,0">
                    <TextBlock x:Name="TxtReadoutLoad" Text="---- %" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="3" Grid.Row="0" Text="Temp" Foreground="#757575"/>
                <Border Grid.Column="3" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="3,2" Margin="0,2,0,0">
                    <TextBlock x:Name="TxtReadoutTemp" Text="---- °C" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Preset Open (55) / Close (420) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnOpen" Content="Open (55)" Margin="0,0,4,0" Height="28" Click="OnOpenClick"/>
                <Button Grid.Column="1" x:Name="BtnClose" Content="Close (420)" Margin="4,0,0,0" Height="28" Click="OnCloseClick"/>
            </Grid>

            <!-- Target Slider -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Target" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="SliderTargetPos" Minimum="55" Maximum="420" Value="55" VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="OnSliderTargetChanged"/>
                <TextBox Grid.Column="2" x:Name="TxtTargetPos" Text="55" Margin="0,0,4,0" VerticalContentAlignment="Center" TextChanged="OnTargetTextChanged"/>
                <Button Grid.Column="3" x:Name="BtnMove" Content="Move" Click="OnMoveClick"/>
            </Grid>

            <!-- Speed & Accel tuning -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Speed" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtSpeed" Text="800" Margin="0,0,10,0" ToolTip="Servo speed (100..3000 steps/s)" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Accel" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" x:Name="TxtAccel" Text="30" ToolTip="Servo acceleration factor (10..200)" VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>
    </GroupBox>
</UserControl>
