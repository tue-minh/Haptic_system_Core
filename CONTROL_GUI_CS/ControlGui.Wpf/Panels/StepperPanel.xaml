<UserControl x:Class="ControlGui.Wpf.Panels.StepperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ControlGui.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="450">
    <GroupBox Header="Stepper Control  (CoreXY + Z)" Margin="0,0,0,6" FontWeight="Bold" Foreground="#212121">
        <StackPanel Margin="6" TextElement.FontWeight="Normal">
            <!-- Telemetry readout -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="X" Foreground="#757575" FontWeight="Bold"/>
                <Border Grid.Column="0" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,2,4,0">
                    <TextBlock x:Name="TxtPosX" Text="+0.00 mm" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1" Grid.Row="0" Text="Y" Foreground="#757575" FontWeight="Bold"/>
                <Border Grid.Column="1" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,2,4,0">
                    <TextBlock x:Name="TxtPosY" Text="+0.00 mm" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="2" Grid.Row="0" Text="Z" Foreground="#757575" FontWeight="Bold"/>
                <Border Grid.Column="2" Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,2,4,0">
                    <TextBlock x:Name="TxtPosZ" Text="+0.00 mm" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="2,0,0,0" Padding="4">
                    <TextBlock x:Name="TxtDriverStatus" Text="OFFLINE" FontWeight="Bold" Foreground="#757575" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Enable Drivers Button -->
            <Button x:Name="BtnEnable" Content="Enable Drivers" Height="28" Margin="0,0,0,8" Click="OnEnableClick" IsEnabled="False"/>

            <!-- Feed & Accel Sliders -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Feed velocity" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.Row="0" x:Name="TxtVel" Text="25.0" Margin="0,0,6,4" TextChanged="OnVelTextChanged"/>
                <Slider Grid.Column="2" Grid.Row="0" x:Name="SliderVel" Minimum="1" Maximum="100" Value="25" VerticalAlignment="Center" ValueChanged="OnSliderVelChanged"/>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Acceleration" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.Row="1" x:Name="TxtAccel" Text="300.0" Margin="0,0,6,0" TextChanged="OnAccelTextChanged"/>
                <Slider Grid.Column="2" Grid.Row="1" x:Name="SliderAccel" Minimum="50" Maximum="1000" Value="300" VerticalAlignment="Center" ValueChanged="OnSliderAccelChanged"/>
            </Grid>

            <!-- Jog Pad: Cross for X/Y, Column for Z, and Full-height E-STOP -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <!-- X- above X+ -->
                <controls:JogButton Grid.Column="1" Grid.Row="0" x:Name="BtnXMinus" Content="X −" Axis="x" Sign="-1" Margin="2"/>
                <controls:JogButton Grid.Column="1" Grid.Row="2" x:Name="BtnXPlus" Content="X +" Axis="x" Sign="1" Margin="2"/>

                <!-- Y+ left of Y- -->
                <controls:JogButton Grid.Column="0" Grid.Row="1" x:Name="BtnYPlus" Content="Y +" Axis="y" Sign="1" Margin="2"/>
                <controls:JogButton Grid.Column="2" Grid.Row="1" x:Name="BtnYMinus" Content="Y −" Axis="y" Sign="-1" Margin="2"/>

                <!-- Separator line -->
                <Rectangle Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" Fill="#E0E0E0" Width="1" HorizontalAlignment="Center"/>

                <!-- Z- above Z+ -->
                <controls:JogButton Grid.Column="4" Grid.Row="0" x:Name="BtnZMinus" Content="Z −" Axis="z" Sign="-1" Margin="2"/>
                <controls:JogButton Grid.Column="4" Grid.Row="2" x:Name="BtnZPlus" Content="Z +" Axis="z" Sign="1" Margin="2"/>

                <!-- EMERGENCY STOP -->
                <Button Grid.Column="5" Grid.Row="0" Grid.RowSpan="3" x:Name="BtnEstop" Content="EMERGENCY STOP" Margin="10,2,2,2" Background="#D32F2F" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Click="OnEstopClick"/>
            </Grid>
        </StackPanel>
    </GroupBox>
</UserControl>
