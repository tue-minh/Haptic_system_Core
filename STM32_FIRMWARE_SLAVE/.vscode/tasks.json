{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "cube-cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Convert ELF to BIN",
            "type": "shell",
            "command": "arm-none-eabi-objcopy",
            "args": [
                "-O",
                "binary",
                "${workspaceFolder}/build/Debug/STM32_FIRMWARE_SLAVE.elf",
                "${workspaceFolder}/build/Debug/STM32_FIRMWARE_SLAVE.bin"
            ],
            "dependsOn": [
                "Build Firmware"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware - USB DFU",
            "type": "shell",
            "command": "dfu-util",
            "args": [
                "-a",
                "0",
                "-s",
                "0x08000000:leave",
                "-D",
                "${workspaceFolder}/build/Debug/STM32_FIRMWARE_SLAVE.bin"
            ],
            "dependsOn": [
                "Build Firmware",
                "Convert ELF to BIN"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware - Black Magic Probe",
            "type": "shell",
            "command": "gdb-multiarch",
            "args": [
                "-x",
                "${workspaceFolder}/.vscode/flash.gdb"
            ],
            "dependsOn": [
                "Build Firmware"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
