{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Configure Firmware",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug",
                "-B",
                "${workspaceFolder}/build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware - USB DFU",
            "type": "shell",
            "command": "dfu-util",
            "args": [
                "-a",
                "0",
                "-s",
                "0x08000000:leave",
                "-D",
                "${workspaceFolder}/build/Debug/MM_control.bin"
            ],
            "dependsOn": [
                "Build Firmware"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware - Black Magic Probe",
            "type": "shell",
            "command": "arm-none-eabi-gdb",
            "args": [
                "-x",
                "${workspaceFolder}/.vscode/flash.gdb"
            ],
            "dependsOn": [
                "Build Firmware"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
